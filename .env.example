# Copy to .env. SQLite lives on disk next to the schema.
DATABASE_URL="file:./dev.db"

# 32-byte base64 secret used to encrypt provider API keys at rest (AES-256-GCM).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY="CHANGE_ME_base64_32_bytes"

# Secret for signing/rotation of auth sessions (reserved). Generate the same way.
AUTH_SECRET="CHANGE_ME_base64_32_bytes"

# --- Postgres (production) ---
# In prisma/schema.prisma set: datasource db { provider = "postgresql" }
# DATABASE_URL="postgresql://user:pass@host:5432/resumee?schema=public"
